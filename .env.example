# No credentials are needed for the default Crossref, DataCite and Europe PMC search.
# PANCITE_CONTACT_EMAIL=researcher@university.edu
# PANCITE_DEFAULT_PROVIDERS=crossref,datacite,europe_pmc

# Optional graph APIs. A configured key does not add a provider to default searches.
# SEMANTIC_SCHOLAR_API_KEY=
# OPENALEX_API_KEY=

# Optional commercial/institutional search.
# SERPAPI_API_KEY=
# SEARCHAPI_API_KEY=
# SCOPUS_API_KEY=
# SCOPUS_INSTTOKEN=
# WOS_API_KEY=
# Legacy SERP_API_KEY and SERPAPI_KEY are also accepted for SerpAPI.

# Optional open-access enrichment; Unpaywall requires an actual contact email.
# UNPAYWALL_EMAIL=researcher@university.edu

# Operational limits.
# PANCITE_TIMEOUT=12
# PANCITE_OPERATION_TIMEOUT=40
# PANCITE_RETRIES=1
# PANCITE_CONCURRENCY=6
# PANCITE_CACHE_TTL=300
# PANCITE_CACHE_SIZE=256
