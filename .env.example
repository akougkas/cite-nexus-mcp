# No credentials are needed for the default Crossref, DataCite and Europe PMC search.
# CITE_NEXUS_CONTACT_EMAIL=researcher@university.edu
# CITE_NEXUS_DEFAULT_PROVIDERS=crossref,datacite,europe_pmc

# Optional graph APIs. A configured key does not add a provider to default searches.
# SEMANTIC_SCHOLAR_API_KEY=
# OPENALEX_API_KEY=

# Optional commercial/institutional search.
# SERPAPI_API_KEY=
# SCOPUS_API_KEY=
# SCOPUS_INSTTOKEN=
# WOS_API_KEY=
# Legacy SERP_API_KEY and SERPAPI_KEY are also accepted.

# Optional open-access enrichment; Unpaywall requires an actual contact email.
# UNPAYWALL_EMAIL=researcher@university.edu

# Operational limits.
# CITE_NEXUS_TIMEOUT=12
# CITE_NEXUS_OPERATION_TIMEOUT=40
# CITE_NEXUS_RETRIES=1
# CITE_NEXUS_CONCURRENCY=6
# CITE_NEXUS_CACHE_TTL=300
# CITE_NEXUS_CACHE_SIZE=256
